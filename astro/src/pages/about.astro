---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';

const ABOUT_FAQ = [
  {
    q: 'Thrive Wellness Clinic คืออะไร?',
    a: 'Thrive Wellness Clinic เป็นคลินิกสุขภาพเชิงลึกในกรุงเทพฯ ที่ใช้แนวทาง Functional Medicine — ตรวจวิเคราะห์หาต้นเหตุของอาการแทนการรักษาตามอาการ บริการครอบคลุมการตรวจ Food Sensitivity ภาวะความไวต่ออาหาร, ฮอร์โมน, HBOT, IV Drip, และโปรแกรมดูแลสุขภาพเฉพาะบุคคล',
  },
  {
    q: 'พญ. ชนากานต์ ตระหง่านศรี (หมอนุ่น) คือใคร?',
    a: 'พญ. ชนากานต์ ตระหง่านศรี เป็นแพทย์เวชศาสตร์ชะลอวัยและโภชนาการ ผู้เชี่ยวชาญด้าน Functional Medicine, Anti-aging Medicine, ฮอร์โมน, และการฟื้นฟูระดับเซลล์ ดูแลผู้ป่วยที่ Thrive Wellness Clinic ที่เดอะ คริสตัล พาร์ค ลาดพร้าว กรุงเทพฯ',
  },
  {
    q: 'Thrive แตกต่างจากคลินิกทั่วไปอย่างไร?',
    a: 'เราไม่รักษาเพียงอาการ แต่ค้นหาต้นเหตุจริงด้วยการตรวจเลือดและการประเมินเชิงลึก ทุกโปรแกรมออกแบบเฉพาะบุคคลตามผลตรวจและเป้าหมายสุขภาพ ไม่ใช่สูตรสำเร็จ นอกจากนี้ยังมีระบบติดตามผลระยะยาวเพื่อให้ผลดีต่อเนื่อง',
  },
  {
    q: 'Thrive อยู่ที่ไหน เปิดวันไหนบ้าง?',
    a: 'ตั้งอยู่ที่ชั้น 2 อาคาร B เดอะ คริสตัล พาร์ค เลขที่ 199 ถนนประดิษฐ์มนูธรรม ลาดพร้าว กรุงเทพฯ 10230 เปิดให้บริการทุกวัน (รวมเสาร์-อาทิตย์) เวลา 10:00–19:00 น. โทร 095-934-9640',
  },
  {
    q: 'บริการของ Thrive มีอะไรบ้าง?',
    a: 'บริการหลักได้แก่: ตรวจ Food Sensitivity ภาวะความไวต่ออาหาร IgG, ตรวจฮอร์โมนเชิงลึก, HBOT ออกซิเจนบำบัด, IV Drip วิตามิน, Glutathione, NAD+, Chelation, ตรวจ DNA, NK Cell Therapy, ตรวจคัดกรองมะเร็ง, วิตามินเฉพาะบุคคล, และโปรแกรมดูแลสุขภาพแบบองค์รวม',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'MedicalClinic',
        '@id': 'https://new.thrivewellnessth.com/#clinic',
        name: 'Thrive Wellness Clinic',
        alternateName: 'ไธรฟ์ เวลเนส เซ็นเตอร์',
        url: 'https://new.thrivewellnessth.com',
        telephone: '+66959349640',
        image: 'https://new.thrivewellnessth.com/og-image.jpg',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '199 ถนนประดิษฐ์มนูธรรม ชั้น 2 อาคาร B เดอะ คริสตัล พาร์ค',
          addressLocality: 'ลาดพร้าว',
          addressRegion: 'กรุงเทพมหานคร',
          postalCode: '10230',
          addressCountry: 'TH',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: 13.8187,
          longitude: 100.5739,
        },
        openingHoursSpecification: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '10:00',
          closes: '19:00',
        },
        medicalSpecialty: ['Anti-Aging Medicine', 'Preventive Medicine', 'Functional Medicine'],
        hasMap: 'https://maps.google.com/?q=199+Pradit+Manutham+Road+Bangkok+10230',
        sameAs: [
          'https://www.facebook.com/thrivewellnessth',
          'https://www.instagram.com/thrivewellnessth',
          'https://line.me/R/ti/p/@thrivewellnessth',
        ],
      },
      {
        '@type': 'Person',
        '@id': 'https://new.thrivewellnessth.com/#dr-chanakan',
        name: 'พญ. ชนากานต์ ตระหง่านศรี',
        alternateName: ['Chanakan Trangansri, MD.', 'หมอนุ่น'],
        jobTitle: 'Medical Director, Anti-aging & Regenerative Medicine',
        worksFor: { '@id': 'https://new.thrivewellnessth.com/#clinic' },
        knowsAbout: ['Anti-aging Medicine', 'Functional Medicine', 'Nutrition Wellness', 'Hormone Balance', 'Lifestyle Medicine', 'Chelation Therapy', 'Regenerative Medicine', 'Weight Management'],
        image: 'https://new.thrivewellnessth.com/dr-chanakan-trangansri-thrive-400x400.jpg',
        url: 'https://new.thrivewellnessth.com/about',
      },
      {
        '@type': 'Person',
        name: 'Dr. Pijak Wongvisit',
        alternateName: 'หมอบาย',
        jobTitle: 'Physician, Preventive Medicine & Regenerative Medicine',
        worksFor: { '@id': 'https://new.thrivewellnessth.com/#clinic' },
        knowsAbout: ['Preventive Medicine', 'Hormone Balance', 'Weight Management', 'Genetic Counseling', 'Regenerative Medicine'],
      },
      {
        '@type': 'Person',
        name: 'Dr. Uravadee Chanchamsang',
        alternateName: 'หมอเอม',
        jobTitle: 'Physician, Regenerative Medicine & Integrative Oncology',
        worksFor: { '@id': 'https://new.thrivewellnessth.com/#clinic' },
        knowsAbout: ['Regenerative Medicine', 'Integrative Oncology', 'Cell Therapy', 'Chelation Therapy', 'Anthroposophic Medicine'],
      },
      {
        '@type': 'AboutPage',
        url: 'https://new.thrivewellnessth.com/about',
        name: 'เกี่ยวกับ Thrive Wellness Clinic',
      },
      {
        '@type': 'FAQPage',
        mainEntity: ABOUT_FAQ.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: 'https://new.thrivewellnessth.com' },
          { '@type': 'ListItem', position: 2, name: 'เกี่ยวกับเรา', item: 'https://new.thrivewellnessth.com/about' },
        ],
      },
    ],
  },
];

const crumbs = [
  { label: 'หน้าแรก', href: '/' },
  { label: 'เกี่ยวกับเรา', href: '/about' },
];
---

<BaseLayout>
  <SEO
    slot="head"
    seoTitle="รู้จัก Thrive Wellness Clinic ลาดพร้าว | หมอนุ่น พญ.ชนากานต์"
    description="รู้จัก Thrive Wellness Clinic คลินิกสุขภาพเชิงลึกที่ The Crystal Park ลาดพร้าว นำโดย พญ.ชนากานต์ ตระหง่านศรี (หมอนุ่น) แพทย์ Anti-aging — โทร 095-934-9640"
    canonicalPath="/about"
    ogImage="/about-hero-1200x630.jpg"
    noIndex={false}
    hreflang={[
      { lang: 'th-TH', href: 'https://new.thrivewellnessth.com/about' },
      { lang: 'en', href: 'https://new.thrivewellnessth.com/about' },
      { lang: 'x-default', href: 'https://new.thrivewellnessth.com/about' },
    ]}
    jsonLd={jsonLd}
  />
  <Header />
  <Breadcrumbs crumbs={crumbs} />

  <section class="service-hero">
    <div class="service-hero__content">
      <div class="service-hero__badge">เกี่ยวกับเรา</div>
      <h1>Thrive Wellness Clinic ดูแลสุขภาพให้ลึกกว่าที่เคย</h1>
      <p>เราเชื่อว่าสุขภาพที่ดีไม่ใช่แค่การไม่ป่วย แต่คือการที่ร่างกายและจิตใจทำงานได้เต็มศักยภาพ ด้วยวิทยาศาสตร์ที่แม่นยำและความใส่ใจที่แท้จริง</p>
      <div class="service-hero__actions">
        <a href="tel:+66959349640" class="btn btn-primary" data-gtm-event="call_click" data-gtm-label="โทรปรึกษา">โทรปรึกษา 095-934-9640</a>
        <a href="https://line.me/R/ti/p/@thrivewellnessth" class="btn btn-secondary" data-gtm-event="line_click" data-gtm-label="LINE ปรึกษาฟรี">LINE ปรึกษาฟรี</a>
      </div>
      <div class="service-hero__stats">
        <div><strong>Crystal Park</strong><span>ลาดพร้าว กรุงเทพ</span></div>
        <div><strong>ทุกวัน</strong><span>10:00-19:00 น.</span></div>
        <div><strong>15+</strong><span>บริการเฉพาะทาง</span></div>
      </div>
    </div>
    <div class="service-hero__media">
      <img src="/about-hero-1200x630.jpg" alt="Thrive Wellness Clinic ลาดพร้าว กรุงเทพ" width="1200" height="630" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <main>
    <section class="section section--cream">
      <div class="container">
        <div class="section-title-center">
          <span class="section-label">Our Philosophy</span>
          <h2 class="section-title">เราเชื่ออะไร?</h2>
        </div>
        <div class="grid-3">
          <div class="card card-body">
            <h3>วิทยาศาสตร์เป็นรากฐาน</h3>
            <p class="text-muted">ใช้ข้อมูลจากการตรวจและการประเมินสุขภาพจริง เพื่อลดการเดาและช่วยให้วางแผนได้ตรงจุด</p>
          </div>
          <div class="card card-body">
            <h3>เฉพาะบุคคลคือหัวใจ</h3>
            <p class="text-muted">ร่างกายแต่ละคนไม่เหมือนกัน โปรแกรมที่ดีจึงควรถูกออกแบบจากอาการ เป้าหมาย และบริบทของแต่ละคน</p>
          </div>
          <div class="card card-body">
            <h3>ดูแลต่อเนื่องระยะยาว</h3>
            <p class="text-muted">เป้าหมายไม่ใช่แค่ตรวจแล้วจบ แต่คือการจัดลำดับสิ่งที่ควรดูแลและติดตามผลให้ไปต่อได้จริง</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
        <div class="section-title-center">
          <span class="section-label">Our Doctors</span>
          <h2 class="section-title">ทีมแพทย์ผู้เชี่ยวชาญ</h2>
          <p style="color:var(--text-2);max-width:560px;margin:0 auto;">แพทย์ทุกท่านที่ Thrive เชี่ยวชาญด้าน Functional Medicine และ Anti-aging — ดูแลโดยหาต้นเหตุ ไม่ใช่แค่รักษาอาการ</p>
        </div>

        <div style="background:#f8fafc;border-radius:16px;border:1.5px solid #e5e7eb;padding:40px;margin-bottom:28px;margin-top:40px;">
          <div style="display:grid;grid-template-columns:auto 1fr;gap:36px;align-items:start;">
            <div style="text-align:center;min-width:160px;">
              <img src="/dr-chanakan-trangansri-thrive-400x400.jpg"
                   alt="พญ. ชนากานต์ ตระหง่านศรี หมอนุ่น Medical Director Thrive Wellness Clinic"
                   style="width:160px;height:160px;border-radius:50%;object-fit:cover;box-shadow:0 4px 20px rgba(0,0,0,.12);"
                   loading="lazy" />
              <div style="margin-top:14px;">
                <div style="font-weight:800;color:var(--navy);font-size:.95rem;">พญ. ชนากานต์ ตระหง่านศรี</div>
                <div style="font-size:.78rem;color:var(--text-3);margin-top:2px;">Chanakan Trangansri, MD.</div>
                <div style="font-size:.8rem;color:var(--sky);font-weight:700;margin-top:4px;">"หมอนุ่น"</div>
              </div>
            </div>
            <div>
              <span class="section-label" style="margin-bottom:10px;display:inline-block;">Medical Director · Anti-aging &amp; Regenerative Medicine</span>
              <p style="color:var(--text-2);line-height:1.8;margin-bottom:16px;">หมอนุ่นออกแบบและดูแลโปรแกรมสุขภาพเฉพาะบุคคลที่ Thrive ด้วยแนวทาง Functional Medicine — ตรวจวิเคราะห์หาต้นเหตุของอาการจากผลตรวจเลือดและการประเมินเชิงลึก แล้วออกแบบแผนดูแลที่ตรงกับสภาพร่างกายของแต่ละคน มีประสบการณ์ดูแลผู้ป่วยมากกว่า 5,000 รายใน 7 ปีที่ผ่านมา</p>
              <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;">
                <span style="background:#e0f2fe;color:#0369a1;padding:5px 14px;border-radius:50px;font-size:.8rem;font-weight:600;">Anti-aging &amp; Regenerative Medicine</span>
                <span style="background:#e0f2fe;color:#0369a1;padding:5px 14px;border-radius:50px;font-size:.8rem;font-weight:600;">Nutrition Wellness</span>
                <span style="background:#e0f2fe;color:#0369a1;padding:5px 14px;border-radius:50px;font-size:.8rem;font-weight:600;">Hormone Balance</span>
                <span style="background:#e0f2fe;color:#0369a1;padding:5px 14px;border-radius:50px;font-size:.8rem;font-weight:600;">Lifestyle Medicine</span>
                <span style="background:#e0f2fe;color:#0369a1;padding:5px 14px;border-radius:50px;font-size:.8rem;font-weight:600;">Chelation &amp; Detox</span>
                <span style="background:#e0f2fe;color:#0369a1;padding:5px 14px;border-radius:50px;font-size:.8rem;font-weight:600;">Weight Management</span>
              </div>
              <div style="font-size:.85rem;color:var(--text-2);line-height:1.8;padding:12px 18px;background:#fff;border-radius:8px;border:1px solid #e5e7eb;">
                <span style="font-weight:700;color:var(--navy);">วุฒิการศึกษา:</span> MD (Doctor of Medicine)
                <span style="padding:0 12px;color:#d1d5db;">|</span>
                <span style="font-weight:700;color:var(--navy);">ภาษา:</span> ภาษาไทย · English
              </div>
            </div>
          </div>
        </div>

        <div class="grid-2">
          <div class="card card-body">
            <div style="display:flex;gap:16px;align-items:flex-start;">
              <div style="width:64px;height:64px;border-radius:50%;background:#e0f2fe;display:flex;align-items:center;justify-content:center;font-size:1.6rem;flex-shrink:0;">👨‍⚕️</div>
              <div>
                <div style="font-weight:700;color:var(--navy);">Dr. Pijak Wongvisit, MD.</div>
                <div style="font-size:.78rem;color:var(--text-3);margin-bottom:8px;">"หมอบาย"</div>
                <p class="text-muted" style="font-size:.85rem;line-height:1.7;">Preventive Medicine · Hormone Balance · Weight Management · Lifestyle Modification · Genetic Counseling · Regenerative Medicine</p>
              </div>
            </div>
          </div>
          <div class="card card-body">
            <div style="display:flex;gap:16px;align-items:flex-start;">
              <div style="width:64px;height:64px;border-radius:50%;background:#e0f2fe;display:flex;align-items:center;justify-content:center;font-size:1.6rem;flex-shrink:0;">👩‍⚕️</div>
              <div>
                <div style="font-weight:700;color:var(--navy);">Dr. Uravadee Chanchamsang, MD.</div>
                <div style="font-size:.78rem;color:var(--text-3);margin-bottom:8px;">"หมอเอม" · MA in Sociology</div>
                <p class="text-muted" style="font-size:.85rem;line-height:1.7;">Regenerative Medicine · Integrative Oncology · Enzyme Therapy · Cell Therapy · Chelation · Anthroposophic Medicine</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--light">
      <div class="container">
        <div class="section-title-center">
          <span class="section-label">What We Do</span>
          <h2 class="section-title">บริการหลักของ Thrive</h2>
        </div>
        <div class="grid-3">
          <a class="service-card" href="/check-up">
            <span class="service-card__icon">🔬</span>
            <h3>ตรวจสุขภาพเชิงลึก</h3>
            <p>เลือกการตรวจตามอาการและเป้าหมาย เช่น Food IgG, ฮอร์โมน, DNA, NK Cell และสารอาหาร</p>
          </a>
          <a class="service-card" href="/iv-drip">
            <span class="service-card__icon">💉</span>
            <h3>IV Drip & Nutrition</h3>
            <p>ดูแลวิตามิน สารอาหาร พลังงาน และการฟื้นฟูตามข้อมูลสุขภาพของแต่ละคน</p>
          </a>
          <a class="service-card" href="/hbot">
            <span class="service-card__icon">🫁</span>
            <h3>HBOT & Longevity</h3>
            <p>ออกซิเจนบำบัดและโปรแกรม recovery สำหรับผู้ที่ต้องการดูแลสุขภาพเชิงป้องกัน</p>
          </a>
        </div>
      </div>
    </section>

    <section class="section section--cream">
      <div class="container">
        <div class="section-title-center">
          <span class="section-label">Evidence-Based</span>
          <h2 class="section-title">แนวทางที่มีวิทยาศาสตร์รองรับ</h2>
          <p style="color:var(--text-2);max-width:560px;margin:0 auto;">Thrive ใช้แนวทาง Functional Medicine และ Precision Medicine ซึ่งได้รับการยืนยันจากงานวิจัยทางการแพทย์ระดับโลก</p>
        </div>
        <div class="grid-2" style="margin-top:40px;">
          <div class="card card-body">
            <h3 style="font-size:1rem;margin-bottom:12px;">Functional Medicine</h3>
            <p class="text-muted" style="line-height:1.8;">แนวทางที่มุ่งค้นหาสาเหตุของโรคในระดับระบบ โดยพิจารณาปัจจัยทางชีววิทยา ไลฟ์สไตล์ และสิ่งแวดล้อมร่วมกัน แทนการรักษาอาการแบบแยกส่วน</p>
          </div>
          <div class="card card-body">
            <h3 style="font-size:1rem;margin-bottom:12px;">Precision Medicine</h3>
            <p class="text-muted" style="line-height:1.8;">งานวิจัยจาก NIH พบว่าการรักษาที่คำนึงถึงพันธุกรรม สิ่งแวดล้อม และไลฟ์สไตล์เฉพาะบุคคลให้ผลลัพธ์ที่ดีกว่าแนวทาง one-size-fits-all อย่างมีนัยสำคัญ [1]</p>
          </div>
        </div>
        <div style="max-width:680px;margin:24px auto 0;padding:16px 20px;background:#fff;border-radius:8px;border:1px solid #e5e7eb;">
          <div style="font-size:.78rem;font-weight:700;color:var(--navy);margin-bottom:8px;">Scientific References</div>
          <ol style="font-size:.78rem;color:var(--text-3);line-height:1.8;padding-left:16px;margin:0;display:flex;flex-direction:column;gap:4px;">
            <li>Collins FS, Varmus H. A new initiative on precision medicine. <em>N Engl J Med.</em> 2015;372(9):793–795. PMID: 25635347</li>
            <li>Hood L, Flores M. A personal view on systems medicine and the emergence of proactive P4 medicine. <em>N Biotechnol.</em> 2012;29(6):613–624. PMID: 22450329</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
