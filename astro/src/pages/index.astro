---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout>
  <SEO
    slot="head"
    seoTitle="Thrive Wellness Center — ดูแลสุขภาพแบบองค์รวมในระดับเซลล์"
    description="คลินิกสุขภาพเชิงลึก Bangkok — ตรวจสุขภาพ, IV Drip, HBOT, Food Intolerance, ฮอร์โมน ดูแลสุขภาพในระดับเซลล์"
    canonicalPath="/"
    ogImage="/og-image.jpg"
    noIndex={false}
  />
  <Header />

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero__inner">
        <div>
          <h1 class="hero__title">ร่างกายคุณสมควรได้รับมากกว่าการตรวจเลือดปกติ</h1>
          <p class="hero__subtitle">เราไม่ได้แค่ "ตรวจ" — เราช่วยคุณค้นหาต้นตอ วางแผน และดูแลสุขภาพในระดับที่คลินิกทั่วไปทำไม่ได้</p>
          <div class="hero__actions">
            <a href="/contact" class="btn btn-primary">ปรึกษาแพทย์ฟรี →</a>
            <a href="/check-up" class="btn btn-ghost">ดูบริการทั้งหมด</a>
          </div>
          <div class="hero__stats">
            <div>
              <div class="hero__stat-number">7+</div>
              <div class="hero__stat-label">ปีดูแลสุขภาพเชิงลึก</div>
            </div>
            <div>
              <div class="hero__stat-number">5,000+</div>
              <div class="hero__stat-label">คนที่ไว้ใจให้เราดูแล</div>
            </div>
            <div>
              <div class="hero__stat-number">20+</div>
              <div class="hero__stat-label">โปรแกรมเฉพาะบุคคล</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    headline="เริ่มต้นออกแบบสุขภาพเฉพาะคุณ"
    subline="ปรึกษาทีม Thrive เพื่อเลือกโปรแกรมตรวจและดูแลสุขภาพที่เหมาะกับเป้าหมายของคุณ"
    primaryBtn={{ label: 'ปรึกษาฟรี', href: '/contact' }}
    secondaryBtn={{ label: 'LINE @thrivewellnessth', href: 'https://line.me/R/ti/p/@thrivewellnessth' }}
  />

  <Footer />
</BaseLayout>
