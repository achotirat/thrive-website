---
import '../styles/global.css';

export interface Props {
  lang?: string;
}

const { lang = 'th' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MKHTH4P9');</script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (Google Ads) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18181967822"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18181967822');
    </script>
    <!-- End Google tag -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-192.png" />

    <!-- Google Fonts: Noto Sans Thai -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MKHTH4P9"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <!-- PDPA Cookie Consent -->
    <div id="pdpa-banner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#1a2b3c;color:#fff;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:.875rem;line-height:1.5;">
      <p style="margin:0;max-width:640px;">เว็บไซต์นี้ใช้คุกกี้เพื่อพัฒนาประสบการณ์การใช้งานและวิเคราะห์การเข้าชม ตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล (PDPA) การใช้งานเว็บไซต์ต่อไปถือว่าคุณยอมรับนโยบายคุกกี้ของเรา</p>
      <button id="pdpa-accept" style="background:#007a72;color:#fff;border:none;border-radius:6px;padding:8px 20px;font-size:.875rem;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;">ยอมรับ</button>
    </div>
    <script is:inline>
      (function() {
        if (!localStorage.getItem('pdpa_accepted')) {
          document.getElementById('pdpa-banner').style.display = 'flex';
        }
        document.getElementById('pdpa-accept').addEventListener('click', function() {
          localStorage.setItem('pdpa_accepted', '1');
          document.getElementById('pdpa-banner').style.display = 'none';
        });
      })();
    </script>

    <script is:inline>
      (() => {
        window.dataLayer = window.dataLayer || [];

        const params = new URLSearchParams(window.location.search);
        const attributionKeys = [
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_term',
          'utm_content',
          'gclid',
          'fbclid',
          'wbraid',
          'gbraid',
        ];

        if (!sessionStorage.getItem('landing_page')) {
          sessionStorage.setItem('landing_page', window.location.href);
          sessionStorage.setItem('referrer', document.referrer || '');
        }

        attributionKeys.forEach((key) => {
          const value = params.get(key);
          if (value) sessionStorage.setItem(key, value);
        });

        window.dataLayer.push({
          event: 'content_view',
          page_path: window.location.pathname,
          page_title: document.title,
        });

        let engaged = false;
        const reportEngaged = () => {
          if (engaged) return;
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          if (scrollable <= 0) return;
          if (window.scrollY / scrollable >= 0.5) {
            engaged = true;
            window.dataLayer.push({
              event: 'content_engaged',
              page_path: window.location.pathname,
            });
            window.removeEventListener('scroll', reportEngaged);
          }
        };
        window.addEventListener('scroll', reportEngaged, { passive: true });

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const target = event.target.closest('[data-gtm-event]');
          if (!target) return;
          window.dataLayer.push({
            event: target.dataset.gtmEvent,
            event_label: target.dataset.gtmLabel || target.textContent.trim(),
            event_href: target.getAttribute('href') || '',
            page_path: window.location.pathname,
          });
        });
      })();
    </script>
  </body>
</html>
