---
type Button = { label: string; href: string };

export interface Props {
  headline: string;
  subline?: string;
  primaryBtn: Button;
  secondaryBtn?: Button;
}

const { headline, subline, primaryBtn, secondaryBtn } = Astro.props;
---

<section class="cta-section">
  <div class="section-container cta-section__inner">
    <h2>{headline}</h2>
    {subline && <p>{subline}</p>}
    <div class="cta-section__actions">
      <a href={primaryBtn.href} class="btn btn-primary" data-gtm-event={primaryBtn.href.startsWith('tel:') ? 'call_click' : 'cta_click'} data-gtm-label={primaryBtn.label}>{primaryBtn.label}</a>
      {secondaryBtn && <a href={secondaryBtn.href} class="btn btn-secondary" data-gtm-event={secondaryBtn.href.includes('line.me') ? 'line_click' : 'cta_click'} data-gtm-label={secondaryBtn.label}>{secondaryBtn.label}</a>}
    </div>
  </div>
</section>

