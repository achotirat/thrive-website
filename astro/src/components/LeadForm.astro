---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

export interface Props {
  serviceSlug: string;
  formTitle?: string;
  lang?: 'th' | 'en' | 'zh-cn';
}

const { serviceSlug, formTitle = 'นัดปรึกษาแพทย์ฟรี', lang = 'th' } = Astro.props;
const copy = lang === 'zh-cn'
  ? { intro: '请留下您的联系方式，Thrive 团队将与您联系，讨论适合的服务。', name: '姓名', phone: '电话号码', line: 'LINE ID', message: '补充信息', consent: '我同意 Thrive Wellness Clinic 根据我提供的信息联系我，讨论预约和咨询事宜。', submit: '发送预约申请' }
  : lang === 'en'
    ? { intro: 'Please request your visit in advance so we can arrange English-speaking support. Staff availability varies by day. We will contact you to confirm your appointment; submitting this form does not reserve a time.', name: 'Full name', phone: 'Phone number', line: 'LINE ID', message: 'Additional message', consent: 'I agree that Thrive Wellness Clinic may contact me using the details I provide about appointments and consultations.', submit: 'Send appointment request' }
    : { intro: 'ฝากข้อมูลไว้ ทีมงาน Thrive Wellness Clinic จะติดต่อกลับเพื่อช่วยเลือกโปรแกรมที่เหมาะกับคุณ', name: 'ชื่อ-นามสกุล', phone: 'เบอร์โทรศัพท์', line: 'LINE ID', message: 'ข้อความเพิ่มเติม', consent: 'ยินยอมให้ Thrive Wellness Clinic ติดต่อกลับตามข้อมูลที่ให้ไว้เพื่อการนัดหมายและให้คำปรึกษา', submit: 'ส่งข้อมูลนัดหมาย' };
---

<section class="section lead-form-section" id="lead-form">
  <div class="section-container lead-form-card">
    <div>
      <span class="section-label">Appointment</span>
      <h2>{formTitle}</h2>
      <p>{copy.intro}</p>
    </div>
    <form class="lead-form" data-service-slug={serviceSlug} data-lang={lang}>
      <input type="hidden" name="service_interest" value={serviceSlug} />
      <input type="hidden" name="source_page" value={serviceSlug} />
      <input type="hidden" name="landing_page" />
      <input type="hidden" name="referrer" />
      <input type="hidden" name="utm_source" />
      <input type="hidden" name="utm_medium" />
      <input type="hidden" name="utm_campaign" />
      <input type="hidden" name="utm_term" />
      <input type="hidden" name="utm_content" />
      <input type="hidden" name="gclid" />
      <input type="hidden" name="fbclid" />
      <input type="hidden" name="wbraid" />
      <input type="hidden" name="gbraid" />
      <input type="hidden" name="consent_version" value="phase1-2026-05" />

      <label>
        {copy.name} *
        <input name="name" type="text" autocomplete="name" required maxlength="120" />
      </label>
      <label>
        {copy.phone} *
        <input name="phone" type="tel" autocomplete="tel" required maxlength="32" />
      </label>
      <label>
        {copy.line}
        <input name="line_id" type="text" autocomplete="off" maxlength="80" />
      </label>
      {lang === 'en' && <label>
        Preferred visit date (optional)
        <input name="preferred_date" type="date" />
      </label>}
      <label>
        {copy.message}
        <textarea name="message" rows="4" maxlength="2000"></textarea>
      </label>
      <label class="lead-form__consent">
        <input name="consent" type="checkbox" value="yes" required />
        <span>{copy.consent}</span>
      </label>

      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
      <p class="lead-form__status" aria-live="polite"></p>
      <button type="submit" class="btn btn-primary">{copy.submit}</button>
    </form>
  </div>
</section>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline>
  // Capture attribution IMMEDIATELY on page load (before anything strips query params)
  (function captureAttributionImmediate() {
    const attributionKeys = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_term',
      'utm_content',
      'gclid',
      'fbclid',
      'wbraid',
      'gbraid',
    ];

    const url = new URL(window.location.href);
    // First-touch only — BaseLayout already captures the true landing page;
    // overwriting here would report "page where the form lives" instead.
    if (!sessionStorage.getItem('landing_page')) {
      sessionStorage.setItem('landing_page', window.location.href);
    }

    attributionKeys.forEach((key) => {
      const value = url.searchParams.get(key);
      if (value) {
        sessionStorage.setItem(key, value);
      }
    });
  })();
</script>

<script>
  type DataLayerWindow = Window & {
    dataLayer?: Array<Record<string, unknown>>;
  };

  // Capture attribution on page load
  (function captureAttribution() {
    const attributionKeys = [
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_term',
      'utm_content',
      'gclid',
      'fbclid',
      'wbraid',
      'gbraid',
    ];

    const url = new URL(window.location.href);

    // First-touch only — keep the page the visitor actually arrived on
    if (!sessionStorage.getItem('landing_page')) {
      sessionStorage.setItem('landing_page', window.location.href);
    }

    // Store each attribution param from URL query string
    attributionKeys.forEach((key) => {
      const value = url.searchParams.get(key);
      if (value) {
        sessionStorage.setItem(key, value);
      }
    });
  })();

  document.querySelectorAll('.lead-form').forEach((element) => {
    if (!(element instanceof HTMLFormElement)) return;

    const form = element;
    const attributionKeys = [
      'landing_page',
      'referrer',
      'utm_source',
      'utm_medium',
      'utm_campaign',
      'utm_term',
      'utm_content',
      'gclid',
      'fbclid',
      'wbraid',
      'gbraid',
    ];
    let started = false;

    const fillAttribution = () => {
      attributionKeys.forEach((key) => {
        const input = form.querySelector(`[name="${key}"]`);
        if (input instanceof HTMLInputElement) input.value = sessionStorage.getItem(key) || '';
      });
    };

    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      const dataLayerWindow = window as DataLayerWindow;
      dataLayerWindow.dataLayer = dataLayerWindow.dataLayer || [];
      dataLayerWindow.dataLayer.push({
        event: 'form_start',
        service: form.dataset.serviceSlug,
        page_path: window.location.pathname,
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      fillAttribution();
      const status = form.querySelector('.lead-form__status');
      const button = form.querySelector('button[type="submit"]');
      const serviceSlug = form.dataset.serviceSlug || '';
    const lang = form.dataset.lang || 'th';
      const formData = new FormData(form);
      formData.set('consent_at', new Date().toISOString());

      if (button instanceof HTMLButtonElement) button.disabled = true;
      if (status instanceof HTMLElement) {
        status.textContent = lang === 'zh-cn' ? '正在发送...' : lang === 'en' ? 'Sending...' : 'กำลังส่งข้อมูล...';
        status.dataset.state = 'loading';
      }

      try {
        const response = await fetch('/api/leads', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        });

        if (!response.ok) throw new Error('Lead submission failed');
        const dataLayerWindow = window as DataLayerWindow;
        dataLayerWindow.dataLayer = dataLayerWindow.dataLayer || [];
        dataLayerWindow.dataLayer.push({
          event: 'lead_submit',
          service: serviceSlug,
          page_path: window.location.pathname,
        });
        const thanksPath = lang === 'th' ? '/thank-you' : `/${lang}/thank-you`;
        window.location.href = `${thanksPath}?service=${encodeURIComponent(serviceSlug)}`;
      } catch (error) {
        if (status instanceof HTMLElement) {
          status.textContent = lang === 'zh-cn'
            ? '暂时无法发送，请通过 LINE 联系我们或致电 095-934-9640。'
            : lang === 'en'
              ? 'The form could not be sent. Please contact us on LINE or call 095-934-9640.'
              : 'ยังส่งแบบฟอร์มไม่ได้ กรุณาติดต่อผ่าน LINE หรือโทร 095-934-9640';
          status.dataset.state = 'error';
        }
        // Turnstile tokens are single-use: without a reset, every retry re-sends
        // the consumed token and fails until the page is reloaded.
        const turnstile = (window as { turnstile?: { reset: (el: Element) => void } }).turnstile;
        const widget = form.querySelector('.cf-turnstile');
        if (turnstile && widget) turnstile.reset(widget);
      } finally {
        if (button instanceof HTMLButtonElement) button.disabled = false;
      }
    });
  });
</script>
