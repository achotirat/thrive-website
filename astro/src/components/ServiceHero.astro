---
type Button = { label: string; href: string };
type Stat = { value: string; label: string };

export interface Props {
  headline: string;
  subline: string;
  image: string;
  imageAlt: string;
  imageWidth?: number;
  imageHeight?: number;
  primaryBtn: Button;
  secondaryBtn?: Button;
  stats?: Stat[];
}

const { headline, subline, image, imageAlt, imageWidth = 1200, imageHeight = 630, primaryBtn, secondaryBtn, stats = [] } = Astro.props;
// Images that are not the standard 1200x630 (e.g. a portrait banner with text) keep their own shape instead of being cropped
const customShape = imageWidth !== 1200 || imageHeight !== 630;
---

<section class="service-hero">
  <div class="service-hero__content">
    <div class="service-hero__badge">Thrive Wellness Clinic</div>
    <h1>{headline}</h1>
    <p>{subline}</p>
    <div class="service-hero__actions">
      <a href={primaryBtn.href} class="btn btn-primary" data-gtm-event="cta_click" data-gtm-label={primaryBtn.label}>{primaryBtn.label}</a>
      {secondaryBtn && <a href={secondaryBtn.href} class="btn btn-secondary" data-gtm-event="cta_click" data-gtm-label={secondaryBtn.label}>{secondaryBtn.label}</a>}
    </div>
    {stats.length > 0 && (
      <div class="service-hero__stats">
        {stats.map((stat) => (
          <div>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    )}
  </div>
  <div class:list={['service-hero__media', { 'service-hero__media--natural': customShape, 'service-hero__media--portrait': imageHeight > imageWidth }]}>
    <img
      src={image}
      alt={imageAlt}
      width={imageWidth}
      height={imageHeight}
      loading="eager"
      fetchpriority="high"
      style={customShape ? `aspect-ratio:${imageWidth} / ${imageHeight}` : undefined}
    />
  </div>
</section>

