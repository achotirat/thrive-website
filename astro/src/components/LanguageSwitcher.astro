---
import { localizedPath, routeSlug } from '../i18n/routes';
import type { SiteLanguage } from '../i18n/routes';

export interface Props { lang?: SiteLanguage }
const { lang = 'th' } = Astro.props;
const slug = routeSlug(Astro.url.pathname);
const links = slug === null ? null : [
  { code: 'th' as const, label: 'ไทย', path: localizedPath('th', slug) },
  { code: 'en' as const, label: 'English', path: localizedPath('en', slug) },
  { code: 'zh-cn' as const, label: '中文', path: localizedPath('zh-cn', slug) },
];
---
{links && <nav class="language-switcher" aria-label="Language / ภาษา / 语言">
  {links.map((link) => <a href={link.path} lang={link.code === 'zh-cn' ? 'zh-CN' : link.code} hreflang={link.code === 'zh-cn' ? 'zh-CN' : link.code} aria-current={lang === link.code ? 'page' : undefined}>{link.label}</a>)}
</nav>}
<style>
  .language-switcher { display:flex; flex-wrap:wrap; align-items:center; gap:4px; font-size:.75rem; }
  .language-switcher a { color:var(--text-2); border:1px solid var(--border); padding:5px 8px; border-radius:999px; white-space:nowrap; }
  .language-switcher a[aria-current="page"] { color:var(--navy); background:var(--navy-l); font-weight:700; }
  :global(.topbar) .language-switcher a { color:#fff; border-color:rgba(255,255,255,.45); }
  :global(.topbar) .language-switcher a[aria-current="page"] { color:var(--navy); border-color:#fff; background:#fff; }
</style>
