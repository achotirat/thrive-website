---
import { localizedPath, routeSlug } from '../i18n/routes';
import type { SiteLanguage } from '../i18n/routes';

export interface Props {
  lang?: SiteLanguage;
  /** Compact single-button variant for the mobile navbar (hidden above 768px). */
  compact?: boolean;
}
const { lang = 'th', compact = false } = Astro.props;
const slug = routeSlug(Astro.url.pathname);
// Pages without a translation: stay on the current page for its own language,
// and send the other language to its homepage.
const pathFor = (code: SiteLanguage) =>
  slug !== null ? localizedPath(code, slug) : code === lang ? Astro.url.pathname : localizedPath(code, '');
const links = [
  { code: 'th' as const, label: 'ไทย', short: 'TH', switchLabel: 'เปลี่ยนเป็นภาษาไทย', path: pathFor('th') },
  { code: 'en' as const, label: 'English', short: 'EN', switchLabel: 'Switch to English', path: pathFor('en') },
];
const other = links.find((link) => link.code !== lang)!;
---
{compact
  ? <a class="language-toggle" href={other.path} lang={other.code} hreflang={other.code} aria-label={other.switchLabel}>{other.short}</a>
  : <nav class="language-switcher" aria-label="Language / ภาษา">
      {links.map((link) => <a href={link.path} lang={link.code} hreflang={link.code} aria-current={lang === link.code ? 'page' : undefined}>{link.label}</a>)}
    </nav>}
<style>
  .language-switcher { display:flex; flex-wrap:wrap; align-items:center; gap:4px; font-size:.75rem; }
  .language-switcher a { color:var(--text-2); border:1px solid var(--border); padding:5px 8px; border-radius:999px; white-space:nowrap; }
  .language-switcher a[aria-current="page"] { color:var(--navy); background:var(--navy-l); font-weight:700; }
  :global(.topbar) .language-switcher a { color:#fff; border-color:rgba(255,255,255,.45); }
  :global(.topbar) .language-switcher a[aria-current="page"] { color:var(--navy); border-color:#fff; background:#fff; }
  .language-toggle { display:none; align-items:center; justify-content:center; min-width:44px; height:36px; padding:0 10px; border:1.5px solid var(--border); border-radius:var(--r-pill); color:var(--navy); font-family:var(--font-en); font-size:.8125rem; font-weight:700; letter-spacing:.04em; background:transparent; }
  .language-toggle:hover, .language-toggle:focus-visible { border-color:var(--navy); background:var(--navy-xl); }
  @media (max-width: 768px) { .language-toggle { display:inline-flex; } }
</style>
