---
import JsonLd from './JsonLd.astro';

type Hreflang = { lang: string; href: string };
type Faq = { q: string; a: string };
type Geo = {
  region: string;
  placename: string;
  position: string;
  icbm: string;
};

export interface Props {
  seoTitle: string;
  description: string;
  canonicalPath: string;
  ogImage: string;
  ogLocale?: string;
  hreflang?: Hreflang[];
  geo?: Geo;
  heroImage?: string;
  noIndex?: boolean;
  publishedAt?: Date | string;
  updatedAt?: Date | string;
  lastMedicalReview?: Date | string;
  reviewedBy?: string;
  medicalSpecialty?: string;
  jsonLd?: Record<string, unknown>[];
  faqs?: Faq[];
}

const {
  seoTitle,
  description,
  canonicalPath,
  ogImage,
  ogLocale = 'th_TH',
  hreflang = [],
  geo,
  heroImage,
  noIndex = false,
  publishedAt,
  updatedAt,
  lastMedicalReview,
  reviewedBy,
  medicalSpecialty,
  jsonLd = [],
  faqs = [],
} = Astro.props;

const absoluteUrl = (path: string) => new URL(path, Astro.site).toString();
const canonicalUrl = absoluteUrl(canonicalPath);
const siteOrigin = new URL(Astro.site!).origin;

// --- Normalization layer -----------------------------------------------------
// Content frontmatter historically hardcoded www.thrivewellnessth.com in
// hreflang hrefs and JSON-LD @ids while canonicals use Astro.site — rewrite
// all of it to the configured site origin so the domain is set in exactly one
// place (astro.config.mjs `site`) and cutover needs a single change.

// hreflang: no English version of the site exists, so emit only th-TH +
// x-default, both pointing at the canonical URL. Pages that pass no hreflang
// (noindexed utility/LP pages) still emit none.
const hreflangResolved: Hreflang[] = hreflang.length
  ? [
      { lang: 'th-TH', href: canonicalUrl },
      { lang: 'x-default', href: canonicalUrl },
    ]
  : [];

const SITE_HOST_RE = /^https?:\/\/(www\.|new\.)?thrivewellnessth\.com/;
const isDoctorName = (v: unknown) =>
  typeof v === 'string' && (v.includes('ชนากานต์') || v.includes('Chanakan'));

const normalizeJsonLd = (node: unknown): unknown => {
  if (Array.isArray(node)) return node.map(normalizeJsonLd);
  if (node && typeof node === 'object') {
    const out: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(node as Record<string, unknown>)) {
      out[k] = normalizeJsonLd(v);
    }
    // Dr. Chanakan is a physician — Person undersells the entity for medical E-E-A-T
    if (out['@type'] === 'Person' && isDoctorName(out.name)) out['@type'] = 'Physician';
    // FAQPage schema must mirror the visible FAQ accordion (Google content-match
    // guideline) — rebuild it from the same `faqs` data FAQSection renders.
    if (out['@type'] === 'FAQPage' && faqs.length) {
      out.mainEntity = faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      }));
    }
    return out;
  }
  if (typeof node === 'string' && SITE_HOST_RE.test(node)) {
    return node.replace(SITE_HOST_RE, siteOrigin);
  }
  return node;
};

const jsonLdResolved = jsonLd.map((s) => normalizeJsonLd(s) as Record<string, unknown>);
// -----------------------------------------------------------------------------

const ogImageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
const heroImageUrl = heroImage ? (heroImage.startsWith('http') ? heroImage : absoluteUrl(heroImage)) : '';
const formatDate = (date?: Date | string) => (date ? new Date(date).toISOString().slice(0, 10) : undefined);
---

<title>{seoTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
<meta name="author" content="Thrive Wellness Clinic" />
{reviewedBy && <meta name="reviewed-by" content={reviewedBy} />}
{medicalSpecialty && <meta name="medical-specialty" content={medicalSpecialty} />}
{publishedAt && <meta property="article:published_time" content={formatDate(publishedAt)} />}
{updatedAt && <meta property="article:modified_time" content={formatDate(updatedAt)} />}
{lastMedicalReview && <meta name="last-medical-review" content={formatDate(lastMedicalReview)} />}
<link rel="canonical" href={canonicalUrl} />
{heroImageUrl && <link rel="preload" as="image" href={heroImageUrl} />}

<meta property="og:type" content="website" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Thrive Wellness Clinic" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{geo && (
  <>
    <meta name="geo.region" content={geo.region} />
    <meta name="geo.placename" content={geo.placename} />
    <meta name="geo.position" content={geo.position} />
    <meta name="ICBM" content={geo.icbm} />
  </>
)}

{hreflangResolved.map((item) => (
  <link rel="alternate" hreflang={item.lang} href={item.href} />
))}

{jsonLdResolved.map((schema) => <JsonLd schema={schema} />)}

