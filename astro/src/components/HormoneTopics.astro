---
// Hormone-only intro + 5 topic cards shown above the hormone quiz (/hormones-quiz).
const topics = [
  {
    th: 'ภาพรวมฮอร์โมนสมดุลหรือไม่',
    en: 'Hormone Balance',
    desc: 'เช็กภาพรวมฮอร์โมนหลักทั้งระบบ ทั้งไทรอยด์ ต่อมหมวกไต และฮอร์โมนเพศ ในการตรวจครั้งเดียว',
    image: '/hormones/topic-balance.jpg',
    alt: 'คู่รักยิ้มอย่างสดใส สื่อถึงฮอร์โมนที่สมดุล',
    position: 'center 95%',
  },
  {
    th: 'อยากมีน้อง เตรียมตัวตั้งครรภ์ไม่ใช้ยา',
    en: 'Fertility Program',
    desc: 'ประเมินฮอร์โมนที่เกี่ยวกับการเจริญพันธุ์ และวางแผนเตรียมร่างกายก่อนตั้งครรภ์ร่วมกับแพทย์',
    image: '/hormones/topic-fertility.jpg',
    alt: 'หญิงตั้งครรภ์ประคองท้องท่ามกลางธรรมชาติ',
    position: 'center',
  },
  {
    th: 'สัญญาณเสี่ยง ภาวะหมดประจำเดือน',
    en: 'Menopause Hormone Support',
    desc: 'ร้อนวูบวาบ นอนไม่หลับ รอบเดือนเปลี่ยน ตรวจฮอร์โมนเพื่อดูแลตัวเองในช่วงเปลี่ยนผ่าน',
    image: '/hormones/topic-menopause.jpg',
    alt: 'ผู้หญิงวัย 40 ปีในชุดสีครีม ยิ้มอย่างมั่นใจ',
    position: 'center 30%',
  },
  {
    th: 'ฮอร์โมนการจัดการความเครียด',
    en: 'Stress Hormone',
    desc: 'Cortisol และ DHEA สะท้อนว่าร่างกายรับมือกับความเครียดสะสมได้ดีแค่ไหน',
    image: '/hormones/topic-stress.jpg',
    alt: 'ผู้หญิงกุมศีรษะจากความเครียดระหว่างทำงาน',
    position: 'center 30%',
  },
  {
    th: 'วางแผนการลดน้ำหนัก และระบบเผาผลาญ',
    en: 'Thyroid Hormone',
    desc: 'ไทรอยด์และอินซูลินเกี่ยวข้องกับการเผาผลาญ น้ำหนักขึ้นง่าย และระดับพลังงานในแต่ละวัน',
    image: '/hormones/topic-thyroid.jpg',
    alt: 'ผู้หญิงใช้สายวัดวัดรอบเอว',
    position: 'center',
  },
];
---

<section class="section hormone-intro">
  <div class="section-container hormone-intro__inner">
    <span class="section-label">ฮอร์โมนคืออะไร</span>
    <h2 class="section-title">ฮอร์โมน ปัจจัยสำคัญของสุขภาพกายและใจในทุกช่วงวัย</h2>
    <p>ระบบฮอร์โมนมีหน้าที่ควบคุมการทำงานในทุกระบบของร่างกาย เมื่ออายุมากขึ้นร่างกายจะผลิตฮอร์โมนได้ลดลง จนอาจเกิดภาวะพร่องฮอร์โมนหรือฮอร์โมนไม่สมดุล ทำให้ร่างกายทำงานผิดปกติ และส่งผลให้เกิดปัญหาสุขภาพตามมาได้</p>
    <p>ความสมดุลของฮอร์โมนเป็นสิ่งจำเป็น เพราะฮอร์โมนแต่ละตัวล้วนพึ่งพากัน ทำให้ร่างกายทำงานประสานกันอย่างเป็นระบบ</p>
    <p>ความไม่สมดุลของฮอร์โมนเพียง 1–2 ตัว ก็อาจทำให้เกิดอาการผิดปกติต่าง ๆ เช่น ระบบเผาผลาญลดลง ไขมันสะสมเพิ่มขึ้น นอนหลับยากขึ้น หงุดหงิดง่าย ซึมเศร้า ผิวแห้งกร้านหมองคล้ำ หรือความต้องการทางเพศลดลง จึงควรตรวจเช็กระดับฮอร์โมนที่สำคัญ และปรับให้กลับเข้าสู่สมดุลอีกครั้ง</p>
  </div>
</section>

<section class="section hormone-topics">
  <div class="section-container">
    <div class="section-title-center">
      <span class="section-label">เลือกหัวข้อที่ตรงกับคุณ</span>
      <h2 class="section-title">ฮอร์โมนเรื่องไหนที่คุณกังวล</h2>
    </div>
    <div class="hormone-topics__grid">
      {topics.map((t) => (
        <a class="hormone-topic" href="#quiz">
          <img src={t.image} alt={t.alt} loading="lazy" style={`object-position:${t.position}`} />
          <div class="hormone-topic__body">
            <span class="hormone-topic__en">{t.en}</span>
            <h3>{t.th}</h3>
            <p>{t.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hormone-intro { background: var(--white); }
  .hormone-intro__inner { max-width: 820px; }
  .hormone-intro__inner p { color: var(--text-2); line-height: 1.9; margin: 0 0 var(--sp-4); }

  .hormone-topics { background: var(--cream-xl); }
  .hormone-topics__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-5);
    margin-top: var(--sp-8);
  }
  .hormone-topic {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .hormone-topic:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(91, 71, 55, .14); }
  .hormone-topic img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .hormone-topic__body { padding: var(--sp-4) var(--sp-5) var(--sp-5); }
  .hormone-topic__en {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .hormone-topic h3 { font-size: 1.05rem; line-height: 1.45; margin: var(--sp-1) 0 var(--sp-2); color: var(--navy); }
  .hormone-topic p { font-size: .88rem; line-height: 1.7; color: var(--text-2); margin: 0; }
</style>
