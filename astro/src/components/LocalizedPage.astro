---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from './SEO.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import LeadForm from './LeadForm.astro';
import { localizedPath, localizedSlugs } from '../i18n/routes';
import type { LocalizedSlug } from '../i18n/routes';
import type { LocalizedPageData } from '../i18n/pages';

export interface Props { lang: 'en' | 'zh-cn'; slug: LocalizedSlug; data: LocalizedPageData }
const { lang, slug, data } = Astro.props;
const zh = lang === 'zh-cn';
const labels = zh
  ? { home: '首页', about: '关于我们', contact: '联系我们', 'iv-drip': '静脉营养', 'check-up': '健康检查', hbot: '高压氧 HBOT', 'mental-health': '心理健康', call: '致电', line: '通过 LINE 联系', location: '诊所地址', hours: '每天 10:00–19:00', faq: '常见问题', explore: '了解服务', formIntro: '留下您的联系方式，团队将联系您安排咨询。', map: '查看地图' }
  : { home: 'Home', about: 'About', contact: 'Contact', 'iv-drip': 'IV Drip', 'check-up': 'Health Check-ups', hbot: 'HBOT', 'mental-health': 'Mental Health', call: 'Call us', line: 'Message on LINE', location: 'Visit us', hours: 'Open daily 10:00–19:00', faq: 'Frequently asked questions', explore: 'Explore our services', formIntro: 'Leave your details and our team will contact you about a consultation.', map: 'View map' };
const path = localizedPath(lang, slug);
const navSlugs: LocalizedSlug[] = ['', 'iv-drip', 'check-up', 'hbot', 'mental-health', 'about', 'contact'];
const name = (s: LocalizedSlug) => s === '' ? labels.home : labels[s];
---
<BaseLayout lang={zh ? 'zh-CN' : 'en'}>
  <SEO slot="head" seoTitle={data.title} description={data.description} canonicalPath={path} ogImage="/og-image.jpg" ogLocale={zh ? 'zh_CN' : 'en_US'} hreflang={[{ lang, href: path }]} faqs={data.faq} />
  <div class="localized-topbar"><div class="section-container"><span>Thrive Wellness Clinic · Bangkok</span><span>{labels.hours} · 095-934-9640</span></div></div>
  <header class="localized-header">
    <div class="section-container localized-header__inner">
      <a href={localizedPath(lang, '')} aria-label="Thrive Wellness Clinic"><img src="/Thrive-logo-160px.png" alt="Thrive Wellness Clinic" width="48" height="48" /></a>
      <nav class="localized-nav" aria-label={zh ? '主导航' : 'Main navigation'}>
        {navSlugs.map((item) => <a href={localizedPath(lang, item)} aria-current={item === slug ? 'page' : undefined}>{name(item)}</a>)}
      </nav>
      <LanguageSwitcher lang={lang} />
    </div>
  </header>
  <main>
    <section class="localized-hero"><div class="section-container localized-hero__inner">
      <span class="section-label">{data.eyebrow}</span>
      <h1>{data.heading}</h1>
      <p>{data.intro}</p>
      <div class="localized-actions">
        <a class="btn btn-primary" href="#lead-form">{data.cta}</a>
        <a class="btn btn-secondary" href="https://line.me/R/ti/p/@thrivewellnessth" data-gtm-event="line_click" data-gtm-label={`${lang}-${slug || 'home'}-hero`}>{labels.line}</a>
      </div>
    </div></section>
    <section class="section"><div class="section-container localized-grid">
      {data.sections.map((section) => <article class="localized-card"><h2>{section.heading}</h2><p>{section.body}</p>{section.points && <ul>{section.points.map((point) => <li>{point}</li>)}</ul>}</article>)}
    </div></section>
    {slug === '' && <section class="section localized-services"><div class="section-container"><h2>{labels.explore}</h2><div class="localized-service-links">{localizedSlugs.filter((item) => item !== '' && item !== 'about' && item !== 'contact').map((item) => <a href={localizedPath(lang, item)}>{name(item)} <span aria-hidden="true">→</span></a>)}</div></div></section>}
    {slug === 'contact' && <section class="section"><div class="section-container localized-contact"><h2>{labels.location}</h2><p>{zh ? '曼谷 Lat Phrao，Pradit Manutham Road 199 号 The Crystal Park B 栋二楼，邮编 10230' : 'The Crystal Park, Building B, 2nd Floor, 199 Pradit Manutham Road, Lat Phrao, Bangkok 10230'}</p><a href="https://maps.google.com/?q=199+Pradit+Manutham+Road+Bangkok+10230" target="_blank" rel="noopener noreferrer">{labels.map} →</a></div></section>}
    <section class="section localized-faq"><div class="section-container"><h2>{labels.faq}</h2>{data.faq.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
    <LeadForm serviceSlug={slug || 'homepage'} formTitle={data.cta} lang={lang} />
  </main>
  <footer class="localized-footer"><div class="section-container"><strong>Thrive Wellness Clinic</strong><p>{labels.hours} · 095-934-9640 · LINE @thrivewellnessth</p><nav aria-label={zh ? '页脚导航' : 'Footer navigation'}>{navSlugs.map((item) => <a href={localizedPath(lang, item)}>{name(item)}</a>)}</nav></div></footer>
</BaseLayout>

<style>
  .localized-topbar { background:var(--navy); color:#fff; font-size:.8rem; padding:7px 0; }
  .localized-topbar .section-container { display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; }
  .localized-header { background:#fff; border-bottom:1px solid var(--border); }
  .localized-header__inner { display:flex; align-items:center; justify-content:space-between; gap:24px; min-height:80px; flex-wrap:wrap; padding-top:12px; padding-bottom:12px; }
  .localized-header img { display:block; object-fit:contain; }
  .localized-nav { display:flex; align-items:center; gap:14px; flex-wrap:wrap; font-size:.85rem; }
  .localized-nav a { color:var(--text-2); }
  .localized-nav a[aria-current="page"] { color:var(--navy); font-weight:700; }
  .localized-hero { background:var(--navy-xl); padding:clamp(56px,8vw,110px) 0; }
  .localized-hero__inner { max-width:950px; }
  .localized-hero h1 { font-size:clamp(2.4rem,5vw,4.4rem); line-height:1.15; color:var(--navy); margin:16px 0 20px; }
  .localized-hero p { max-width:740px; font-size:clamp(1.05rem,2vw,1.3rem); color:var(--text-2); line-height:1.8; }
  .localized-actions { display:flex; gap:12px; flex-wrap:wrap; margin-top:28px; }
  .localized-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr)); gap:20px; }
  .localized-card { border:1px solid var(--border); border-radius:var(--r-lg); padding:clamp(24px,3vw,36px); background:#fff; }
  .localized-card h2, .localized-services h2, .localized-faq h2, .localized-contact h2 { color:var(--navy); font-size:clamp(1.35rem,2.5vw,2rem); margin:0 0 16px; }
  .localized-card p { color:var(--text-2); line-height:1.8; }
  .localized-card ul { margin:18px 0 0; padding-left:24px; color:var(--text-2); line-height:1.9; }
  .localized-services, .localized-faq { background:var(--navy-xl); }
  .localized-service-links { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr)); gap:12px; }
  .localized-service-links a { display:flex; justify-content:space-between; padding:18px; border-radius:var(--r-md); background:#fff; color:var(--navy); font-weight:700; border:1px solid var(--border); }
  .localized-faq details { border-bottom:1px solid var(--border); padding:18px 0; }
  .localized-faq summary { cursor:pointer; color:var(--navy); font-weight:700; }
  .localized-faq p { color:var(--text-2); line-height:1.8; margin:12px 0 0; }
  .localized-contact p { color:var(--text-2); }
  .localized-footer { background:var(--navy); color:#fff; padding:48px 0; }
  .localized-footer p { opacity:.85; margin:10px 0 20px; }
  .localized-footer nav { display:flex; gap:16px; flex-wrap:wrap; margin-bottom:22px; }
  .localized-footer nav a { color:#fff; font-size:.9rem; }
  @media(max-width:800px) { .localized-header__inner { align-items:flex-start; } .localized-nav { order:3; width:100%; overflow:auto; flex-wrap:nowrap; padding-bottom:5px; } .localized-nav a { white-space:nowrap; } }
</style>
