---
// Five hormone topic cards (photo + accent colour), each linking to its own
// topic quiz at /hormones-quiz/<slug>. Used on /hormones-quiz, /check-up,
// /check-up/hormones and on every topic quiz page.
import { hormoneTopics } from '../lib/hormoneTopicQuizzes.mjs';

export interface Props { id?: string; }
const { id = 'hormone-topics' } = Astro.props;

type TopicCard = { th: string; en: string; color: string; desc: string; image: string; alt: string; position: string };

const cardsBySlug: Record<string, TopicCard> = {
  balance: {
    th: 'ภาพรวมฮอร์โมนสมดุลหรือไม่',
    en: 'Hormone Balance',
    color: '#008a7f',
    desc: 'เช็กภาพรวมฮอร์โมนหลักทั้งระบบ ทั้งไทรอยด์ ต่อมหมวกไต และฮอร์โมนเพศ',
    image: '/hormones/topic-balance.jpg',
    alt: 'ผู้หญิงสุขภาพดีถือแอปเปิลเขียว สื่อถึงฮอร์โมนที่สมดุล',
    position: 'center 35%',
  },
  preconception: {
    th: 'อยากมีน้อง เตรียมตัวตั้งครรภ์ไม่ใช้ยา',
    en: 'Fertility Program',
    color: '#d4708a',
    desc: 'ประเมินฮอร์โมนที่เกี่ยวกับการเจริญพันธุ์ และวางแผนเตรียมร่างกายก่อนตั้งครรภ์ร่วมกับแพทย์',
    image: '/hormones/topic-fertility.jpg',
    alt: 'คู่รักหยอกล้อกันอย่างมีความสุขบนโซฟา',
    position: 'center',
  },
  menopause: {
    th: 'สัญญาณเสี่ยง ภาวะหมดประจำเดือน',
    en: 'Menopause Hormone Support',
    color: '#9a6fb0',
    desc: 'ร้อนวูบวาบ นอนไม่หลับ รอบเดือนเปลี่ยน ตรวจฮอร์โมนเพื่อดูแลตัวเองในช่วงเปลี่ยนผ่าน',
    image: '/hormones/topic-menopause.jpg',
    alt: 'ผู้หญิงวัย 40 ปีในชุดสีครีม ยิ้มอย่างมั่นใจ',
    position: 'center 30%',
  },
  stress: {
    th: 'ฮอร์โมนการจัดการความเครียด',
    en: 'Stress Hormone',
    color: '#d98c3a',
    desc: 'Cortisol และ DHEA สะท้อนว่าร่างกายรับมือกับความเครียดสะสมได้ดีแค่ไหน',
    image: '/hormones/topic-stress.jpg',
    alt: 'ผู้ชายนั่งเครียดหน้าแล็ปท็อป',
    position: 'center',
  },
  'weight-thyroid': {
    th: 'วางแผนการลดน้ำหนัก และระบบเผาผลาญ',
    en: 'Thyroid Hormone',
    color: '#5e8f5a',
    desc: 'ไทรอยด์และอินซูลินเกี่ยวข้องกับการเผาผลาญ น้ำหนักขึ้นง่าย และระดับพลังงานในแต่ละวัน',
    image: '/hormones/topic-thyroid.jpg',
    alt: 'ผู้หญิงใช้สายวัดวัดรอบเอว',
    position: 'center',
  },
};

const cards = hormoneTopics.map((topic) => {
  const card = cardsBySlug[topic.slug];
  if (!card) throw new Error(`No card for hormone topic "${topic.slug}"`);
  return { ...card, href: topic.href };
});
---

<section class="section hormone-topics" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-container">
    <div class="section-title-center">
      <span class="section-label">เลือกหัวข้อที่ตรงกับคุณ</span>
      <h2 class="section-title" id={`${id}-title`}>ฮอร์โมนเรื่องไหนที่คุณกังวล</h2>
      <p class="section-desc">ตอบคำถามสั้น ๆ แยกตามเรื่อง ใช้เวลาประมาณ 2 นาที ดูผลเบื้องต้นได้ทันที</p>
    </div>
    <div class="hormone-topics__grid">
      {cards.map((c) => (
        <a class="hormone-topic" href={c.href} style={`--topic-color:${c.color}`}>
          <img src={c.image} alt={c.alt} loading="lazy" style={`object-position:${c.position}`} />
          <div class="hormone-topic__body">
            <span class="hormone-topic__en">{c.en}</span>
            <h3>{c.th}</h3>
            <p>{c.desc}</p>
            <span class="hormone-topic__cta">ทำแบบทดสอบ ฟรี! →</span>
          </div>
        </a>
      ))}
    </div>
    <p class="hormone-topics__note">แบบประเมินนี้ไม่ใช่การวินิจฉัยโรคหรือการตรวจระดับฮอร์โมน ผลอาจเกิดได้จากหลายสาเหตุ โปรดปรึกษาแพทย์หากมีอาการหรือกังวล</p>
  </div>
</section>

<style>
  .hormone-topic {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 2px solid var(--topic-color);
    border-top-width: 6px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(91, 71, 55, .08);
    color: inherit;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .hormone-topic:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(91, 71, 55, .18); }
  .hormone-topic img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .hormone-topic__body { display: flex; flex-direction: column; flex: 1; padding: var(--sp-4) var(--sp-5) var(--sp-5); }
  .hormone-topic__en {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--topic-color);
  }
  .hormone-topic h3 { font-size: 1.05rem; line-height: 1.45; margin: var(--sp-1) 0 var(--sp-2); color: var(--navy); }
  .hormone-topic p { font-size: .88rem; line-height: 1.7; color: var(--text-2); margin: 0 0 var(--sp-4); }
  .hormone-topic__cta {
    margin-top: auto;
    align-self: flex-start;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--topic-color);
    color: #fff;
    font-size: .88rem;
    font-weight: 700;
    transition: filter .2s ease;
  }
  .hormone-topic:hover .hormone-topic__cta { filter: brightness(1.08); }
</style>
