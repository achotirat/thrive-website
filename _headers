# ⚠️ NOT DEPLOYED — legacy file. The Netlify publish dir is astro/dist, so headers
# come from netlify.toml [[headers]] ONLY. This file has already drifted from the
# live CSP. Do not copy it into astro/public/. Single source of truth: netlify.toml.

/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self' https://api.thrivewellnessth.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://qr-official.line.me https://cdn.sanity.io https://www.google-analytics.com https://www.google.com https://www.google.co.th https://googleads.g.doubleclick.net; connect-src 'self' https://api.thrivewellnessth.com https://www.google-analytics.com https://region1.google-analytics.com https://www.google.com https://googleads.g.doubleclick.net; frame-src https://challenges.cloudflare.com; upgrade-insecure-requests

/data/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/private/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/api/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
